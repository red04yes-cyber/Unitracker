<UserControl x:Class="UniToStudyHub.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,30,32,36">
                        <TextBlock Text="CARRIERA UNIVERSITARIA" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock AutomationProperties.IsControlElement="True" AutomationProperties.AutomationId="PageHeading.Courses" Text="Le tue materie" Style="{StaticResource PageTitleStyle}"
                                   Margin="0,7,0,4"/>
                        <TextBlock Text="Tieni insieme insegnamenti da preparare, esami conclusi e risultati registrati."
                                   Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>
    
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Aggiungi un insegnamento"
                                           Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <StackPanel Width="300" Margin="0,0,10,0">
                                        <TextBlock Text="Nome materia" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding CourseNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Nome dell'insegnamento"/>
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,10,0">
                                        <TextBlock Text="CFU" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding CourseCfuInput, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Crediti formativi"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text=" " FontSize="10" Margin="0,0,0,5"/>
                                        <Button Content="Aggiungi materia" Command="{Binding AddCourseCommand}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
    
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="Registra un tentativo d’esame" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Registra un esame superato (accettato o rifiutato), non superato oppure un’idoneità. Il voto numerico serve solo per gli esiti superati."
                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <StackPanel Width="300" Margin="0,0,10,0">
                                            <TextBlock Text="Materia" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding Courses}"
                                                      DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedGradeCourse}"/>
                                        </StackPanel>
                                        <StackPanel Width="185" Margin="0,0,10,0">
                                            <TextBlock Text="Esito del tentativo" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                            <ComboBox ItemsSource="{Binding AttemptModeOptions}" SelectedItem="{Binding AttemptModeInput}"/>
                                        </StackPanel>
                                        <StackPanel Width="90" Margin="0,0,10,0">
                                            <TextBlock Text="Voto (18–30)" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding GradeValueInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text=" " FontSize="10" Margin="0,0,0,5"/>
                                            <Button Content="Registra tentativo" Command="{Binding AddGradeCommand}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
    
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Archivio insegnamenti" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Le materie con un voto registrato sono raccolte nell'archivio."
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AllCoursesCount, StringFormat={}{0} materie totali}"
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
    
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CourseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Cerca per nome o codice" MinWidth="190"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <RadioButton Content="{Binding ActiveCoursesCount, StringFormat='In corso ({0})'}"
                                             GroupName="CourseFilters" Tag="active"
                                             IsChecked="True" Checked="CourseFilter_Checked"
                                             Style="{StaticResource FilterRadioButtonStyle}"/>
                                <RadioButton Content="{Binding ArchivedCoursesCount, StringFormat='Archivio ({0})'}"
                                             GroupName="CourseFilters" Tag="archive"
                                             Checked="CourseFilter_Checked"
                                             Style="{StaticResource FilterRadioButtonStyle}"/>
                                <RadioButton Content="Tutte" GroupName="CourseFilters" Tag="all"
                                             Checked="CourseFilter_Checked"
                                             Style="{StaticResource FilterRadioButtonStyle}"/>
                            </StackPanel>
                        </Grid>
    
                        <ItemsControl ItemsSource="{Binding VisibleCourses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            Width="286" MinHeight="142" Margin="0,0,12,12"
                                            Padding="17">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="6" Padding="8,4"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Cfu, StringFormat={}{0} CFU}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Code, TargetNullValue='Codice non indicato'}"
                                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,7,0,13"/>
                                            <Border x:Name="CourseStatusBorder"
                                                    Background="{DynamicResource SubtleBrush}" CornerRadius="6"
                                                    Padding="8,5" HorizontalAlignment="Left">
                                                <TextBlock x:Name="CourseStatusText" Text="IN CORSO"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                            <Setter TargetName="CourseStatusBorder" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                            <Setter TargetName="CourseStatusText" Property="Text" Value="SUPERATO"/>
                                            <Setter TargetName="CourseStatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
    
                        <StackPanel Visibility="{Binding NoVisibleCourses, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    HorizontalAlignment="Stretch">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="28">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Nessuna materia da mostrare"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource InkBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CourseEmptyMessage}"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               MaxWidth="480" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
