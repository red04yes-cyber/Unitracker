<UserControl x:Class="UniToStudyHub.Views.StudyLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,30,32,36">
            <TextBlock Text="STUDIO E MEMORIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Studio Lab" Style="{StaticResource PageTitleStyle}" Margin="0,7,0,4"/>
            <TextBlock Text="Concentrazione, attività, ripasso e diario degli errori. Le azioni vengono salvate nel profilo locale." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>
            
            <TabControl Margin="0,0,0,8" SelectedIndex="0">
                <TabControl.Resources>
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="Padding" Value="18,10"/>
                        <Setter Property="Margin" Value="0,0,8,12"/>
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Focus"><StackPanel>
                    <TextBlock Text="Una sessione alla volta: scegli la materia, imposta la durata e concentrati." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"/>
                    <Border Background="{DynamicResource NavyBrush}" CornerRadius="14" Padding="24" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="SESSIONE DI FOCUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SidebarMutedBrush}"/>
                        <TextBlock Text="{Binding Workspace.FocusRemainingDisplay}" FontSize="48" FontWeight="SemiBold" Foreground="White" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Workspace.FocusStateDisplay}" FontSize="12" Foreground="{DynamicResource SidebarMutedBrush}"/>
                        <ProgressBar Value="{Binding Workspace.FocusProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding Workspace.FocusElapsedDisplay}" FontSize="10" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Workspace.FocusBreakStateDisplay}" FontSize="10" Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Workspace.FocusBreakRemainingDisplay}" FontSize="23" FontWeight="SemiBold" Foreground="White" Margin="0,3,0,0"/>
                        <ProgressBar Value="{Binding Workspace.FocusBreakProgressPercent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding Workspace.FocusTopicInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Argomento" Margin="0,16,0,0"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Workspace.Courses}" DisplayMemberPath="Name" SelectedItem="{Binding Workspace.SelectedFocusCourse}" ToolTip="Materia"/>
                            <TextBox Grid.Column="1" Text="{Binding Workspace.FocusMinutesInput, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="Minuti"/>
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Avvia" Command="{Binding Workspace.StartFocusCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                            <Button Content="Pausa" Command="{Binding Workspace.PauseFocusCommand}" IsEnabled="{Binding Workspace.CanPauseFocus}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                            <Button Content="Riprendi" Command="{Binding Workspace.ResumeFocusCommand}" IsEnabled="{Binding Workspace.CanResumeFocus}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                            <Button Content="Termina" Command="{Binding Workspace.FinishFocusCommand}" IsEnabled="{Binding Workspace.CanFinishFocus}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                            <Button Content="Annulla" Command="{Binding Workspace.CancelFocusCommand}" IsEnabled="{Binding Workspace.CanFinishFocus}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="Preset rapidi:" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0"/>
                        <ComboBox Width="165" ItemsSource="{Binding Workspace.FocusPresetOptions}" SelectedItem="{Binding Workspace.FocusPresetInput}" ToolTip="Durata della sessione"/>
                    </WrapPanel>
                </StackPanel></TabItem>
                <TabItem Header="Attività"><StackPanel>
                    <TextBlock Text="Organizza i prossimi passi e pianifica i blocchi nel calendario." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Attività aperte" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox Text="{Binding Workspace.TaskTitleInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Titolo attività" Margin="0,12,0,0"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Workspace.Courses}" DisplayMemberPath="Name" SelectedItem="{Binding Workspace.SelectedTaskCourse}" ToolTip="Materia"/>
                            <TextBox Grid.Column="1" Text="{Binding Workspace.TaskMinutesInput, UpdateSourceTrigger=PropertyChanged}" Margin="7,0,0,0" ToolTip="Minuti stimati"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Workspace.TaskPriorityOptions}" SelectedItem="{Binding Workspace.TaskPriorityInput}" Margin="7,0,0,0" ToolTip="Priorità">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='P{0}'}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <DatePicker SelectedDate="{Binding Workspace.TaskDueDateInput}" ToolTip="Scadenza (facoltativa)" Margin="0,8,0,0"/>
                        <Button Content="Aggiungi attività" Command="{Binding Workspace.AddTaskCommand}" Margin="0,10,0,10"/>
                        <ListBox ItemsSource="{Binding Workspace.ActiveTasks}" SelectedItem="{Binding Workspace.SelectedTask}" MinHeight="140" MaxHeight="220">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding EstimatedMinutes, StringFormat={}{0} min stimati}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding DueAt, StringFormat='Scadenza · {0:dd/MM/yyyy}', TargetNullValue='Senza scadenza'}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Priority, StringFormat='Priorità {0}/5'}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Nessuna attività aperta. Aggiungi un task per organizzare il prossimo passo." Visibility="{Binding Workspace.NoActiveTasks, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,7,2,0"/>
                        <WrapPanel Margin="0,8,0,0"><Button Content="Completa" Command="{Binding Workspace.CompleteTaskCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Rimuovi" Click="RemoveStudyTask_Click" IsEnabled="{Binding Workspace.HasSelectedTask}" Style="{StaticResource QuietButtonStyle}"/></WrapPanel>
                    </StackPanel>
                </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Planner di studio · anteprima" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Inserisci le tue fasce giornaliere reali nel formato HH:mm-HH:mm; più fasce si separano con ;. Saranno ripetute per i giorni del periodo selezionato." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                    <TextBox Text="{Binding Workspace.PlannerAvailabilityInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Per esempio 08:30-12:00;15:00-18:00" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Dal" Style="{StaticResource KpiLabelStyle}"/><DatePicker SelectedDate="{Binding Workspace.PlannerFromInput}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Al" Style="{StaticResource KpiLabelStyle}"/><DatePicker SelectedDate="{Binding Workspace.PlannerToInput}"/></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Genera anteprima" Command="{Binding Workspace.PreviewStudyPlanCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6"/>
                        <Button Content="Applica al calendario" Command="{Binding Workspace.ApplyStudyPlanCommand}" IsEnabled="{Binding Workspace.HasPlanPreview}" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Workspace.PlannerStatus}" FontSize="11" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Workspace.PlanPreviewSummary}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
                    <TextBlock Text="Blocchi proposti" Style="{StaticResource KpiLabelStyle}" Margin="0,10,0,5"/>
                    <ListBox ItemsSource="{Binding Workspace.CurrentPlanPreview.Blocks}" MaxHeight="135">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock Text="{Binding StartsAt, StringFormat={}{0:ddd dd/MM HH:mm}}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding EndsAt, StringFormat={}{0:HH:mm}}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Task non pianificati" Style="{StaticResource KpiLabelStyle}" Margin="0,10,0,5"/>
                    <ItemsControl ItemsSource="{Binding Workspace.CurrentPlanPreview.UnscheduledTasks}">
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/><TextBlock Text="{Binding Reason}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
                </StackPanel></TabItem>
                <TabItem Header="Ripasso"><StackPanel>
                    <TextBlock Text="Riprendi le flashcard dovute e trasforma gli errori in occasioni di apprendimento." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Ripasso flashcard" Style="{StaticResource SectionTitleStyle}"/>
                        <ListBox ItemsSource="{Binding Workspace.DueFlashcards}" SelectedItem="{Binding Workspace.SelectedDueFlashcard}" MaxHeight="110" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Front}" FontSize="11" TextWrapping="Wrap" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <TextBlock Text="Nessuna flashcard in scadenza." Visibility="{Binding Workspace.NoDueFlashcards, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,7,2,0"/>
                        <Button Content="Mostra / nascondi risposta" Command="{Binding Workspace.RevealFlashcardCommand}" Style="{StaticResource QuietButtonStyle}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Workspace.SelectedDueFlashcard.Back}" Visibility="{Binding Workspace.FlashcardRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="Again" Command="{Binding Workspace.ReviewAgainCommand}" Style="{StaticResource QuietButtonStyle}" Margin="0,0,6,6"/><Button Content="Hard" Command="{Binding Workspace.ReviewHardCommand}" Style="{StaticResource QuietButtonStyle}" Margin="0,0,6,6"/><Button Content="Good" Command="{Binding Workspace.ReviewGoodCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/><Button Content="Easy" Command="{Binding Workspace.ReviewEasyCommand}" Margin="0,0,6,6"/></WrapPanel>
                        <TextBlock Text="Nuova flashcard" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,7"/>
                        <TextBox Text="{Binding Workspace.FlashcardFrontInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fronte"/><TextBox Text="{Binding Workspace.FlashcardBackInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Retro" Margin="0,7,0,0"/>
                        <Button Content="Aggiungi flashcard" Command="{Binding Workspace.AddFlashcardCommand}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Diario degli errori" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Registra il quesito, la risposta errata e quella corretta per pianificare il ripasso." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                        <TextBox Text="{Binding Workspace.ErrorTopicInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Argomento"/><TextBox Text="{Binding Workspace.ErrorQuestionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Domanda o esercizio" Margin="0,7,0,0"/><TextBox Text="{Binding Workspace.ErrorIncorrectInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Risposta errata (facoltativa)" Margin="0,7,0,0"/><TextBox Text="{Binding Workspace.ErrorCorrectInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Risposta corretta" Margin="0,7,0,0"/><TextBox Text="{Binding Workspace.ErrorCauseInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Causa (facoltativa)" Margin="0,7,0,0"/>
                        <Button Content="Registra errore" Command="{Binding Workspace.AddErrorEntryCommand}" Margin="0,9,0,12"/>
                        <ListBox ItemsSource="{Binding Workspace.OpenErrorEntries}" SelectedItem="{Binding Workspace.SelectedErrorEntry}" MaxHeight="120"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Topic}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Question}" FontSize="11" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <TextBlock Text="Nessun errore da ripassare." Visibility="{Binding Workspace.NoOpenErrorEntries, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,7,2,0"/>
                        <WrapPanel Margin="0,8,0,0"><Button Content="Da ripassare" Command="{Binding Workspace.ReviewErrorNeedsWorkCommand}" Style="{StaticResource QuietButtonStyle}" Margin="0,0,6,0"/><Button Content="Ricordato" Command="{Binding Workspace.ReviewErrorRememberedCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
                </StackPanel></TabItem>
                <TabItem Header="Benessere"><StackPanel>
                    <TextBlock Text="Tieni traccia delle energie e parcheggia le distrazioni senza interrompere lo studio." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Check-in energia e focus" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Registra come ti senti: sono annotazioni personali, non valutazioni automatiche." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="{Binding Workspace.EnergyLevelInput, StringFormat='Energia · {0}/5'}" FontSize="11" Foreground="{DynamicResource InkBrush}"/>
                        <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Workspace.EnergyLevelInput}"/>
                        <TextBlock Text="{Binding Workspace.SelfFocusLevelInput, StringFormat='Focus percepito · {0}/5'}" FontSize="11" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"/>
                        <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Workspace.SelfFocusLevelInput}"/>
                        <TextBox Text="{Binding Workspace.EnergyNoteInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nota facoltativa" Margin="0,8,0,0"/>
                        <Button Content="Salva check-in" Command="{Binding Workspace.AddEnergyCheckInCommand}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                        <ItemsControl ItemsSource="{Binding Workspace.RecentEnergyCheckIns}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RecordedAt, StringFormat='dd/MM HH:mm'}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EnergyLevel, StringFormat='Energia {0}/5'}" FontSize="9" Foreground="{DynamicResource InkBrush}"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Parcheggio distrazioni" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Annota ciò che ti distrae e torna al compito senza perderlo." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBox Text="{Binding Workspace.DistractionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Annota una distrazione"/>
                        <Button Content="Aggiungi nota" Command="{Binding Workspace.AddDistractionCommand}" HorizontalAlignment="Left" Margin="0,9,0,10"/>
                        <ListBox ItemsSource="{Binding Workspace.OpenDistractions}" SelectedItem="{Binding Workspace.SelectedDistraction}" MaxHeight="150">
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd/MM HH:mm'}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Nessuna distrazione annotata." Visibility="{Binding Workspace.NoOpenDistractions, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,7,2,0"/>
                        <Button Content="Segna come risolta" Command="{Binding Workspace.ResolveDistractionCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
                </StackPanel></TabItem>
            </TabControl>
            <TextBlock Text="{Binding Workspace.WorkspaceStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,14,2,0"/></StackPanel>
    </ScrollViewer>
</UserControl>
