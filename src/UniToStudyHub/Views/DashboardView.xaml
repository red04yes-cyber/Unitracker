<UserControl AutomationProperties.AutomationId="Page.Dashboard" AutomationProperties.Name="Dashboard" x:Class="UniToStudyHub.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IL TUO WORKSPACE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock AutomationProperties.AutomationId="PageHeading.Dashboard" Text="Bentornato." Style="{StaticResource PageTitleStyle}" Margin="0,7,0,4"/>
                                <TextBlock Text="La tua situazione universitaria, le priorità e il tempo dedicato allo studio."
                                           Style="{StaticResource PageSubtitleStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SubtleBrush}"
                                    CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding MoodleStatus}" FontSize="11"
                                               Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
    
                        <Grid Margin="0,22,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource NavyBrush}" CornerRadius="16"
                                    Padding="26" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="IL TUO PROSSIMO PASSO" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource SidebarMutedBrush}"/>
                                    <TextBlock Text="Trasforma il tempo di oggi in progressi concreti."
                                               FontSize="23" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap" Margin="0,10,0,8"/>
                                    <TextBlock Text="Studio Lab è pronto: avvia una sessione di focus, organizza le attività e riprendi da dove avevi lasciato."
                                               FontSize="12" Foreground="{DynamicResource SidebarMutedBrush}"
                                               TextWrapping="Wrap" MaxWidth="620"/>
                                    <WrapPanel Margin="0,18,0,0">
                                        <Button Content="Avvia una sessione focus"
                                                Command="{Binding Workspace.StartFocusCommand}"
                                                Margin="0,0,10,8"/>
                                        <Button Content="Apri le materie"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="NavigateToSubjects_Click" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Workspace.FocusStateDisplay}" FontSize="11"
                                               Foreground="{DynamicResource SidebarMutedBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
    
                            <ui:CardControl Grid.Column="1" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="PROSSIMO ESAME" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding NextExamNameDisplay}" FontSize="18"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" Margin="0,12,0,5"/>
                                    <TextBlock Text="{Binding NextExamDateDisplay}" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="8"
                                            Padding="10,8" Margin="0,16,0,0">
                                        <TextBlock Text="Le date del pianificatore sono indicative: verifica sempre gli appelli sulle fonti ufficiali."
                                                   FontSize="10" Foreground="{DynamicResource WarningBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </ui:CardControl>
                        </Grid>
    
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <ui:CardControl Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="CFU ACQUISITI" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding AcquiredCreditsValue}" FontSize="27"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,2"/>
                                    <TextBlock Text="Crediti dagli esami registrati" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl>
                            <ui:CardControl Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="MEDIA PONDERATA" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding AverageDisplay}" FontSize="27"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,2"/>
                                    <TextBlock Text="Calcolata sui CFU validi" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl>
                            <ui:CardControl Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="FOCUS REGISTRATO" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding Workspace.FocusMinutesDisplay}" FontSize="24"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,2"/>
                                    <TextBlock Text="Periodo di riferimento" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Workspace.ProgressPeriodDisplay}" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl>
                            <ui:CardControl Padding="18">
                                <StackPanel>
                                    <TextBlock Text="TASK COMPLETATI" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding Workspace.CompletedTasksDisplay}" FontSize="24"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,2"/>
                                    <TextBlock Text="Attività completate nel periodo" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:CardControl>
                        </UniformGrid>
    
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:CardControl Grid.Column="0" Padding="20" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="SESSIONE DI FOCUS" Style="{StaticResource KpiLabelStyle}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Workspace.FocusRemainingDisplay}" FontSize="34"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="{Binding Workspace.FocusStateDisplay}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Workspace.FocusElapsedDisplay}"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Workspace.FocusProgressPercent}" Maximum="100"
                                                 Height="6" Margin="0,14,0,10"/>
                                    <WrapPanel>
                                        <Button Content="Avvia" Command="{Binding Workspace.StartFocusCommand}" Margin="0,0,8,8"/>
                                        <Button Content="Pausa" Command="{Binding Workspace.PauseFocusCommand}" Margin="0,0,8,8"/>
                                        <Button Content="Riprendi" Command="{Binding Workspace.ResumeFocusCommand}" Margin="0,0,8,8"/>
                                        <Button Content="Termina" Command="{Binding Workspace.FinishFocusCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock Text="Il timer mostra lo stato della sessione salvata, non un conteggio separato della dashboard."
                                               FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ui:CardControl>
    
                            <ui:CardControl Grid.Column="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="OBIETTIVO SETTIMANALE" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding Workspace.WeeklyGoalDisplay}" FontSize="18"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                               TextWrapping="Wrap" Margin="0,10,0,6"/>
                                    <ProgressBar Value="{Binding Workspace.WeeklyGoalProgressPercent}" Maximum="100"
                                                 Height="7" Margin="0,8,0,12"/>
                                    <TextBlock Text="{Binding Workspace.ProgressPeriodDisplay}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="{Binding Workspace.FocusStreakDisplay}" FontSize="22"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,14,0,2"/>
                                    <TextBlock Text="Giorni consecutivi con focus registrato" FontSize="10"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </ui:CardControl>
                        </Grid>
    
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:CardControl Grid.Column="0" Padding="20" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="ULTIMO RISULTATO REGISTRATO" Style="{StaticResource KpiLabelStyle}"/>
                                    <TextBlock Text="{Binding LatestGradeDisplay}" FontSize="14"
                                               Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </ui:CardControl>
                            <ui:CardControl Grid.Column="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="LE TUE MATERIE" Style="{StaticResource KpiLabelStyle}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ActiveCoursesCount}" FontSize="25"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Attive" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ArchivedCoursesCount}" FontSize="25"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Text="Concluse / archivio" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:CardControl>
                        </Grid>
    
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="2,16,2,0"/>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
