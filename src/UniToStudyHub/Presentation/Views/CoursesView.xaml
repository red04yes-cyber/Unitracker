<UserControl x:Class="UniToStudyHub.Presentation.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniToStudyHub.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,36,40,48">
                    <TextBlock Text="CARRIERA UNIVERSITARIA" FontSize="11"
                               FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                    <TextBlock Text="Le tue materie" Style="{StaticResource PageTitleStyle}"
                               Margin="0,7,0,4"/>
                    <TextBlock Text="Tieni insieme insegnamenti da preparare, esami conclusi e risultati registrati."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Aggiungi un insegnamento"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <StackPanel Width="300" Margin="0,0,10,0">
                                    <TextBlock Text="Nome materia" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding State.CourseNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Nome dell'insegnamento"/>
                                </StackPanel>
                                <StackPanel Width="105" Margin="0,0,10,0">
                                    <TextBlock Text="CFU" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding State.CourseCfuInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Crediti formativi"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text=" " FontSize="11" Margin="0,0,0,5"/>
                                    <Button Content="Aggiungi materia" Command="{Binding State.AddCourseCommand}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding State.StatusMessage}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Registra un tentativo d’esame" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Registra un esame superato (accettato o rifiutato), non superato oppure un’idoneità. Il voto numerico serve solo per gli esiti superati."
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="300" Margin="0,0,10,0">
                                        <TextBlock Text="Materia" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding State.Courses}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding State.SelectedGradeCourse}"/>
                                    </StackPanel>
                                    <StackPanel Width="185" Margin="0,0,10,0">
                                        <TextBlock Text="Esito del tentativo" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding State.AttemptModeOptions}" SelectedItem="{Binding State.AttemptModeInput}"/>
                                    </StackPanel>
                                    <StackPanel Width="90" Margin="0,0,10,0">
                                        <TextBlock Text="Voto (18–30)" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding State.GradeValueInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text=" " FontSize="11" Margin="0,0,0,5"/>
                                        <Button Content="Registra tentativo" Command="{Binding State.AddGradeCommand}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Archivio insegnamenti" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Le materie con un voto registrato sono raccolte nell'archivio."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding State.AllCoursesCount, StringFormat={}{0} materie totali}"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" MinWidth="190">
                            <TextBox Text="{Binding State.CourseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Cerca per nome o codice" Padding="36,10,12,10"/>
                            <Ellipse Width="10" Height="10" Stroke="{DynamicResource MutedBrush}"
                                     StrokeThickness="1.6" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Margin="13,0,0,0"
                                     IsHitTestVisible="False"/>
                            <Path Data="M 0,0 L 5,5" Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.6" Width="6" Height="6"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="25,7,0,0" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Content="{Binding State.ActiveCoursesCount, StringFormat='In corso ({0})'}"
                                         GroupName="CourseFilters" Tag="active"
                                         IsChecked="True" Checked="CourseFilter_Checked"
                                         Style="{StaticResource FilterRadioButtonStyle}"/>
                            <RadioButton Content="{Binding State.ArchivedCoursesCount, StringFormat='Archivio ({0})'}"
                                         GroupName="CourseFilters" Tag="archive"
                                         Checked="CourseFilter_Checked"
                                         Style="{StaticResource FilterRadioButtonStyle}"/>
                            <RadioButton Content="Tutte" GroupName="CourseFilters" Tag="all"
                                         Checked="CourseFilter_Checked"
                                         Style="{StaticResource FilterRadioButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding State.VisibleCourses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}"
                                        Width="286" MinHeight="142" Margin="0,0,12,12"
                                        Padding="17">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="6" Padding="8,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Cfu, StringFormat={}{0} CFU}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Code, TargetNullValue='Codice non indicato'}"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,7,0,13"/>
                                        <Border x:Name="CourseStatusBorder"
                                                Background="{DynamicResource SubtleBrush}" CornerRadius="6"
                                                Padding="8,5" HorizontalAlignment="Left">
                                            <TextBlock x:Name="CourseStatusText" Text="IN CORSO"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                        <Setter TargetName="CourseStatusBorder" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                        <Setter TargetName="CourseStatusText" Property="Text" Value="SUPERATO"/>
                                        <Setter TargetName="CourseStatusText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding State.NoVisibleCourses, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="164" Height="104" Stretch="Uniform" Margin="0,0,0,12">
                                    <Canvas Width="164" Height="104">
                                        <Ellipse Width="118" Height="14" Canvas.Left="23" Canvas.Top="84"
                                                 Fill="{DynamicResource SubtleBrush}"/>
                                        <Border Width="112" Height="6" Canvas.Left="26" Canvas.Top="73"
                                                Background="{DynamicResource GoldAccentBrush}" CornerRadius="3"/>
                                        <Rectangle Width="7" Height="18" Canvas.Left="38" Canvas.Top="78"
                                                   Fill="{DynamicResource MutedBrush}"/>
                                        <Rectangle Width="7" Height="18" Canvas.Left="119" Canvas.Top="78"
                                                   Fill="{DynamicResource MutedBrush}"/>
                                        <Border Width="60" Height="44" Canvas.Left="53" Canvas.Top="20"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource AccentCyanBrush}"
                                                BorderThickness="2" CornerRadius="6" Padding="5">
                                            <Grid>
                                                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="2"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center" Margin="0,0,0,5">
                                                    <Rectangle Width="5" Height="8" Fill="{DynamicResource AccentCyanBrush}" Margin="0,0,3,0"/>
                                                    <Rectangle Width="5" Height="13" Fill="{DynamicResource ElectricBlueBrush}" Margin="0,0,3,0"/>
                                                    <Rectangle Width="5" Height="17" Fill="{DynamicResource BrickAccentBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Path Data="M 74,65 L 91,65 L 97,72 L 68,72 Z"
                                              Fill="{DynamicResource BorderBrush}" Stroke="{DynamicResource MutedBrush}"
                                              StrokeThickness="1"/>
                                        <Path Data="M 20,70 C 29,60 39,60 47,68 C 55,60 64,60 73,70 L 73,80 C 63,73 55,73 47,80 C 39,73 29,73 20,80 Z"
                                              Fill="{DynamicResource AccentSoftBrush}"
                                              Stroke="{DynamicResource AccentCyanBrush}" StrokeThickness="1.5"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Nessuna materia da mostrare"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding State.CourseEmptyMessage}"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="480" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
</UserControl>
