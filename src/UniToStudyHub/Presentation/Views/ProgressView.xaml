<UserControl x:Class="UniToStudyHub.Presentation.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniToStudyHub.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,36,40,48">
        <TextBlock Text="IL TUO ANDAMENTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
        <TextBlock Text="Progressi" Style="{StaticResource PageTitleStyle}" Margin="0,7,0,4"/>
        <TextBlock Text="{Binding State.Workspace.ProgressPeriodDisplay, StringFormat='Periodo · {0}'}" Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="TEMPO DI FOCUS" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding State.Workspace.FocusMinutesDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="SESSIONI COMPLETATE" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding State.Workspace.CompletedSessionsDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="TASK COMPLETATI" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding State.Workspace.CompletedTasksDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="FLASHCARD DOVUTE" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding State.Workspace.DueFlashcardsDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="ERRORI APERTI" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding State.Workspace.OpenErrorsDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="STREAK FOCUS" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding State.Workspace.FocusStreakDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Obiettivo settimanale" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding State.Workspace.WeeklyGoalDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0"/><ProgressBar Value="{Binding State.Workspace.WeeklyGoalProgressPercent, Mode=OneWay}" Maximum="100" Height="7" Margin="0,12,0,0"/><TextBlock Text="Il totale deriva dalle sessioni di focus salvate, non da stime o tempo trascorso con l'app aperta." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Per materia" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding State.Workspace.CourseProgressRows}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CourseName}" FontSize="12" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FocusMinutesDisplay}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding FocusPercent}" Maximum="100" Height="5" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl><TextBlock Text="Le statistiche sono calcolate sugli ultimi sette giorni (da lunedì a oggi). Le metriche vuote restano indicate come dati insufficienti." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Focus giornaliero · ultimi sette giorni" Style="{StaticResource SectionTitleStyle}"/>
                <ItemsControl ItemsSource="{Binding State.Workspace.DailyProgressRows}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4,0">
                                <TextBlock Text="{Binding FocusMinutes, StringFormat={}{0} min}"
                                           FontSize="9" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <ProgressBar Orientation="Vertical" Value="{Binding FocusPercent}"
                                             Maximum="100" Width="22" Height="92"
                                             VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DayLabel}" FontSize="10"
                                           Foreground="{DynamicResource InkBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Esporta report XLSX (ultimi 7 giorni)" Click="ExportProgress_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding State.Workspace.ExportStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
</UserControl>
