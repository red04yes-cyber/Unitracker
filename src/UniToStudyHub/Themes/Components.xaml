<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UniToStudyHub">
    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="QuietButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Foreground" Value="#241219"/>
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style x:Key="FilterRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="FilterSurface" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FilterSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FilterSurface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="local:MotionBehavior.HoverLiftEnabled" Value="True"/>
        <Setter Property="local:MotionBehavior.EntranceEnabled" Value="True"/>
    </Style>
    <Style x:Key="ElevatedCardBorderStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource ElevatedPanelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="KpiLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="BadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SuccessBadgeStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    </Style>
    <Style x:Key="WarningBadgeStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
    </Style>
    <Style x:Key="DangerBadgeStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
    </Style>
    <Style x:Key="InfoBadgeStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
    </Style>
    <Style x:Key="PurpleBadgeStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
</ResourceDictionary>
