<Window x:Class="UniToStudyHub.DesktopNextActivityWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniTo · Prossima attività" Width="330" Height="190"
        MinWidth="280" MinHeight="160" ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False"
        Background="#F4F6FA" WindowStartupLocation="Manual">
    <Border Margin="12" Padding="18" Background="White" CornerRadius="14" BorderBrush="#DDE3EC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="LA TUA PROSSIMA ATTIVITÀ" FontSize="10" FontWeight="Bold" Foreground="#5574A5"/>
            <TextBlock Grid.Row="1" Text="{Binding NextActivityDisplay}" FontSize="17" FontWeight="SemiBold"
                       Foreground="#1D2A3B" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,12,0,12"/>
            <Button Grid.Row="2" Content="Chiudi widget" Click="CloseWidget_Click" HorizontalAlignment="Right"
                    Padding="12,6" Background="#EDF1F7" BorderBrush="#DDE3EC"/>
        </Grid>
    </Border>
</Window>