            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,30,32,36">
        <TextBlock Text="MATERIALI DIDATTICI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AiBrush}"/>
        <TextBlock Text="AI &amp; PDF Intelligence" Style="{StaticResource PageTitleStyle}" Margin="0,7,0,4"/>
        <TextBlock Text="Importa PDF locali, cerca nel testo estratto e usa l'assistente solo quando un provider è configurato." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Libreria documenti" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Importazione locale: il documento non viene inviato a un servizio remoto." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                    <Button Content="Importa PDF" Click="ImportPdf_Click" HorizontalAlignment="Left"/>
                    <ListBox ItemsSource="{Binding Workspace.PdfDocuments}" SelectedItem="{Binding Workspace.SelectedPdf}" Margin="0,12,0,0" MinHeight="230">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding PageCount, StringFormat={}{0} pagine}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding HasExtractableText, StringFormat='Testo estraibile: {0}'}" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="La libreria è vuota: importa il primo PDF." Visibility="{Binding Workspace.NoPdfDocuments, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="2,7,2,0"/>
                    <TextBlock Text="{Binding Workspace.PdfDocumentSummary}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="Anteprima del testo estratto" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,14,0,6"/>
                    <ListBox ItemsSource="{Binding Workspace.SelectedPdf.Pages}" MaxHeight="250">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding PageNumber, StringFormat='Pagina {0}'}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding Text}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="100"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Workspace.PdfStatus}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Ricerca nel documento" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Gli estratti provengono dal testo memorizzato pagina per pagina." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Workspace.PdfSearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cerca una frase o un concetto"/><Button Grid.Column="1" Content="Cerca" Command="{Binding Workspace.SearchPdfCommand}" Margin="8,0,0,0"/></Grid>
                        <ListBox ItemsSource="{Binding Workspace.PdfSearchHits}" MaxHeight="230" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding PageNumber, StringFormat='Pagina {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding Snippet}" FontSize="11" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <TextBlock Text="Nessun risultato da mostrare." Visibility="{Binding Workspace.NoPdfSearchHits, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="2,7,2,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Assistente sul documento" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Provider non configurato: nessuna domanda viene inviata e non vengono mostrate risposte simulate." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                        <TextBox Text="{Binding Workspace.PdfQuestionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Scrivi una domanda sul documento"/>
                        <Button Content="Chiedi sul documento" Command="{Binding Workspace.AskPdfCommand}" Margin="0,9,0,10" HorizontalAlignment="Left"/>
                        <Border Background="{StaticResource AiSoftBrush}" CornerRadius="8" Padding="11"><TextBlock Text="{Binding Workspace.AiStatusMessage}" FontSize="11" Foreground="{StaticResource AiBrush}" TextWrapping="Wrap"/></Border>
                        <TextBlock Text="{Binding Workspace.AiResponseText}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</ScrollViewer>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#263955">
                        <TextBlock Text="06" Foreground="#DCE7F7" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Progressi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Statistiche di carriera" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,30,32,36">
        <TextBlock Text="IL TUO ANDAMENTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Progressi" Style="{StaticResource PageTitleStyle}" Margin="0,7,0,4"/>
        <TextBlock Text="{Binding Workspace.ProgressPeriodDisplay, StringFormat='Periodo · {0}'}" Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="TEMPO DI FOCUS" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding Workspace.FocusMinutesDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="SESSIONI COMPLETATE" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding Workspace.CompletedSessionsDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="TASK COMPLETATI" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding Workspace.CompletedTasksDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="FLASHCARD DOVUTE" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding Workspace.DueFlashcardsDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10"><StackPanel><TextBlock Text="ERRORI APERTI" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding Workspace.OpenErrorsDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="STREAK FOCUS" Style="{StaticResource KpiLabelStyle}"/><TextBlock Text="{Binding Workspace.FocusStreakDisplay}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Obiettivo settimanale" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding Workspace.WeeklyGoalDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,10,0,0"/><ProgressBar Value="{Binding Workspace.WeeklyGoalProgressPercent}" Maximum="100" Height="7" Margin="0,12,0,0"/><TextBlock Text="Il totale deriva dalle sessioni di focus salvate, non da stime o tempo trascorso con l'app aperta." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Per materia" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding Workspace.CourseProgressRows}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CourseName}" FontSize="11" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FocusMinutesDisplay}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding FocusPercent}" Maximum="100" Height="5" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl><TextBlock Text="Le statistiche sono calcolate sugli ultimi sette giorni (da lunedì a oggi). Le metriche vuote restano indicate come dati insufficienti." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
        </Grid>
    </StackPanel>
</ScrollViewer>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#263955">
                        <TextBlock Text="07" Foreground="#DCE7F7" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Impostazioni" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Profilo e integrazioni" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,30,32,36">
        <TextBlock Text="CONFIGURAZIONE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Impostazioni" Style="{StaticResource PageTitleStyle}" Margin="0,7,0,4"/>
        <TextBlock Text="Gestisci integrazioni, dati locali e copie di sicurezza." Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>
        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Profilo universitario" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Questi dati sono personali e organizzativi: non vengono presentati come informazioni ufficiali UniTo." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                <TextBlock Text="Corso di laurea" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Workspace.DegreeProgramNameInput, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Codice / classe" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/><TextBox Text="{Binding Workspace.DegreeProgramCodeInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="CFU totali previsti" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/><TextBox Text="{Binding Workspace.DegreeTotalCfuInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Lascia vuoto se non vuoi configurare il totale"/></StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Anno di iscrizione" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/><TextBox Text="{Binding Workspace.EnrollmentYearInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Anno accademico corrente" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/><TextBox Text="{Binding Workspace.CurrentAcademicYearInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Obiettivo laurea" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding Workspace.GraduationTargetInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Ore di studio a settimana" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/><TextBox Text="{Binding Workspace.WeeklyStudyHoursInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                </Grid>
                <TextBlock Text="Limite giornaliero (minuti)" Style="{StaticResource KpiLabelStyle}" Margin="0,10,0,5"/>
                <TextBox Text="{Binding Workspace.MaxDailyStudyMinutesInput, UpdateSourceTrigger=PropertyChanged}" MaxWidth="220" HorizontalAlignment="Left"/>
                <TextBlock Text="Preferenze di studio" Style="{StaticResource KpiLabelStyle}" Margin="0,10,0,5"/>
                <TextBox Text="{Binding Workspace.StudyPreferencesInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                <Button Content="Salva profilo" Command="{Binding Workspace.SaveAcademicProfileCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding Workspace.WorkspaceStatus}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Connessione Moodle" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Collega il tuo spazio Moodle UniTo per sincronizzare i corsi e accedere ai materiali consentiti." Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,16"/>
                <TextBlock Text="URL della piattaforma" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding MoodleUrlInput, UpdateSourceTrigger=PropertyChanged}" MaxWidth="600" HorizontalAlignment="Stretch"/>
                <TextBlock Text="Token Web Services" Style="{StaticResource KpiLabelStyle}" Margin="0,14,0,5"/>
                <PasswordBox x:Name="MoodleTokenBox" MaxWidth="600" HorizontalAlignment="Stretch" Padding="11,9" PasswordChanged="MoodleTokenBox_PasswordChanged"/>
                <WrapPanel Margin="0,16,0,0"><Button Content="Verifica e salva token" Command="{Binding ConnectMoodleCommand}" Margin="0,0,8,0"/><Button Content="Sincronizza corsi" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SyncMoodleCommand}"/></WrapPanel>
                <Border Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding MoodleStatus}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/></Border>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Dati e backup" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Le copie sono locali e includono un manifest di formato e checksum. I backup non sono cifrati." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <TextBlock Text="Cartella backup" Style="{StaticResource KpiLabelStyle}"/>
                <TextBox Text="{Binding Workspace.BackupDirectory}" IsReadOnly="True" Margin="0,5,0,10"/>
                <Button Content="Crea backup e verifica integrità" Command="{Binding Workspace.CreateBackupCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="Backup disponibili" Style="{StaticResource KpiLabelStyle}" Margin="0,16,0,6"/>
                <ListBox ItemsSource="{Binding Workspace.BackupItems}" SelectedItem="{Binding Workspace.SelectedBackup}" MinHeight="90" MaxHeight="220">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding FilePath}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} byte}" FontSize="9" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Sha256, StringFormat='SHA-256 · {0}'}" FontSize="8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding IntegrityVerified, StringFormat=Integrità verificata: {0}}" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Non hai ancora creato backup locali." Visibility="{Binding Workspace.NoBackups, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="2,7,2,0"/>
                <WrapPanel Margin="0,9,0,0"><Button Content="Verifica backup selezionato" Command="{Binding Workspace.VerifyBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Ripristino non disponibile" IsEnabled="False" Style="{StaticResource QuietButtonStyle}" ToolTip="In attesa che il contratto tecnico restituisca il percorso del backup di sicurezza"/></WrapPanel>
                <TextBlock Text="{Binding Workspace.BackupStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding Workspace.BackupManifestSummary}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <TextBlock Text="Il ripristino resta disattivato finché il servizio non espone alla UI il percorso effettivo del backup di sicurezza creato prima della sostituzione del database." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
        </TabItem>
    </TabControl>
</Window>