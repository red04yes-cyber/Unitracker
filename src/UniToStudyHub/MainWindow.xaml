<Window x:Class="UniToStudyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UniToStudyHub.Presentation.Controls"
        xmlns:views="clr-namespace:UniToStudyHub.Presentation.Views"
        Title="UniTo StudyHub"
        Icon="{StaticResource UnitrackerAppIcon}"
        Height="920"
        Width="1480"
        MinHeight="740"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="244"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveIndicator"
                                        Grid.Column="0"
                                        Width="3"
                                        CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Stretch"
                                        Margin="0,5,0,5"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource SidebarActiveBrush}"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource SidebarHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs"
                TabStripPlacement="Left"
                SelectedIndex="0"
                Background="{DynamicResource PageBrush}"
                BorderThickness="0">
        <TabControl.Template>
            <ControlTemplate TargetType="{x:Type TabControl}">
                <Grid SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="272"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="24,26,20,20">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="48" Height="48" CornerRadius="15"
                                            BorderBrush="#554D6680" BorderThickness="1"
                                            Background="{DynamicResource NavyBrush}" VerticalAlignment="Center">
                                        <Grid>
                                            <Path Data="M 10,10 L 10,26 C 10,35 36,35 36,26 L 36,10"
                                                  Stroke="{DynamicResource AccentCyanBrush}"
                                                  StrokeThickness="5" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" Fill="Transparent"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <Rectangle Width="3" Height="7" RadiusX="1" RadiusY="1"
                                                           Fill="{DynamicResource ElectricBlueBrush}" Margin="0,0,2,0"/>
                                                <Rectangle Width="3" Height="12" RadiusX="1" RadiusY="1"
                                                           Fill="{DynamicResource ElectricBlueBrush}" Margin="0,0,2,0"/>
                                                <Rectangle Width="3" Height="16" RadiusX="1" RadiusY="1"
                                                           Fill="{DynamicResource ElectricBlueBrush}"/>
                                            </StackPanel>
                                            <Canvas IsHitTestVisible="False">
                                                <Polygon Points="4,11 17,5 30,11 17,17"
                                                         Fill="{DynamicResource BrickAccentBrush}"/>
                                                <Path Data="M 27,12 L 29,22"
                                                      Stroke="{DynamicResource BrickAccentBrush}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                                <Ellipse Width="3" Height="3" Canvas.Left="27.5" Canvas.Top="21"
                                                         Fill="{DynamicResource BrickAccentBrush}"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Unitracker" Foreground="White"
                                                   FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="UniTo StudyHub" Foreground="{DynamicResource SidebarMutedBrush}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="IL TUO PERCORSO UNIVERSITARIO"
                                           Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                           FontWeight="Bold" Margin="2,24,0,0"/>
                            </StackPanel>

                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Margin="12,4,12,8"/>

                            <StackPanel Grid.Row="2" Margin="24,12,22,24">
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.55" Margin="0,0,0,14"/>
                                <TextBlock Text="Organizza. Studia. Cresci."
                                           Foreground="{DynamicResource SidebarTextBrush}" FontSize="12"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Il tuo percorso, a modo tuo."
                                           Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="86"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="32,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="UNITO STUDYHUB  /  AREA PERSONALE" FontSize="10"
                                               FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock x:Name="PageHeading" Text="Oggi" FontSize="19"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                               Margin="0,2,0,0"/>
                                    <TextBlock x:Name="PageSubheading" Text="La tua dashboard" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SubtleBrush}"
                                            CornerRadius="9" Padding="12,8"
                                            VerticalAlignment="Center" MaxWidth="230">
                                        <TextBlock Text="{Binding MoodleStatus}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button x:Name="ThemeToggleButton"
                                            Content="Modalità scura"
                                            Style="{StaticResource QuietButtonStyle}"
                                            ToolTip="Cambia tema chiaro o scuro"
                                            Margin="0,0,8,0"
                                            Click="ToggleTheme_Click"/>
                                    <Button Content="Impostazioni"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Margin="6,0,0,0"
                                            ToolTip="Apri le impostazioni"
                                            Click="NavigateToSettings_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{DynamicResource PageBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="OG" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Oggi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="La tua dashboard" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="MA" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Materie" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Corsi e archivio" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:CoursesView DataContext="{Binding Courses}" />
        </TabItem>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="CA" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Calendario" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Appelli e pianificazione" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:CalendarView DataContext="{Binding Calendar}" />
        </TabItem>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="SL" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Studio Lab" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Focus e allenamento" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:StudyLabView DataContext="{Binding StudyLab}" />
        </TabItem>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="AC" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Accademia" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Apprendimento intelligente" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:AcademyView DataContext="{Binding Academy}" />
        </TabItem>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="PR" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Progressi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Statistiche di carriera" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:ProgressView DataContext="{Binding Progress}" />
        </TabItem>

        <TabItem>
<TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SidebarBadgeBrush}">
                        <TextBlock Text="IM" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Impostazioni" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Profilo e integrazioni" FontSize="11" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>