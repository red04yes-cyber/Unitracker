                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,12,0" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Storico dei voti" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding LatestGradeDisplay}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/>
                                <DataGrid ItemsSource="{Binding Grades}" IsReadOnly="True"
                                          MinHeight="110" MaxHeight="300"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserResizeRows="False" CanUserSortColumns="True"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Materia" Binding="{Binding CourseName}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="Voto" Binding="{Binding Value}"
                                                            Width="62"/>
                                        <DataGridTextColumn Header="CFU" Binding="{Binding Cfu}"
                                                            Width="54"/>
                                        <DataGridTextColumn Header="Data"
                                                            Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                                            Width="94"/>
                                        <DataGridCheckBoxColumn Header="Lode" Binding="{Binding Honors}"
                                                                Width="58"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Stato degli insegnamenti"
                                               Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ActiveCoursesCount}" FontSize="24"
                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="In corso" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ArchivedCoursesCount}" FontSize="24"
                                                       FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Text="In archivio" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding AllCoursesCount, StringFormat={}{0} materie complessive}"
                                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Prossimo esame" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding NextExamNameDisplay}" FontSize="15"
                                               FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                               TextWrapping="Wrap" Margin="0,11,0,4"/>
                                    <TextBlock Text="{Binding NextExamDateDisplay}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    <Border Background="{StaticResource WarningSoftBrush}"
                                            CornerRadius="7" Padding="9,7" Margin="0,14,0,0">
                                        <TextBlock Text="Le date pianificate sono indicative: verifica sempre gli appelli ufficiali."
                                                   FontSize="10" Foreground="#8A5B1D"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Come leggere questi dati" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="I CFU derivano dagli esami registrati. La media ponderata considera il peso dei CFU; la media aritmetica usa l'ultimo voto per materia. Il voto di partenza è una proiezione matematica e non rappresenta una garanzia sul voto finale. I dati sul tempo di studio e sui ripassi saranno mostrati quando saranno disponibili registrazioni reali."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#263955">
                        <TextBlock Text="07" Foreground="#DCE7F7" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Impostazioni" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Preferenze e dati" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,30,32,36">
                    <TextBlock Text="CONFIGURAZIONE" FontSize="10"
                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Impostazioni" Style="{StaticResource PageTitleStyle}"
                               Margin="0,7,0,4"/>
                    <TextBlock Text="Gestisci le integrazioni utilizzate da StudyHub."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>

                    <Border Style="{StaticResource CardBorderStyle}" MaxWidth="760"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Connessione Moodle"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Collega il tuo spazio Moodle UniTo per sincronizzare i corsi e accedere ai materiali consentiti."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,16"/>
                            <TextBlock Text="URL della piattaforma" Style="{StaticResource KpiLabelStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding MoodleUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                     MaxWidth="600" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="Token Web Services" Style="{StaticResource KpiLabelStyle}"
                                       Margin="0,14,0,5"/>
                            <PasswordBox x:Name="MoodleTokenBox" MaxWidth="600"
                                         HorizontalAlignment="Stretch" Padding="11,9"
                                         PasswordChanged="MoodleTokenBox_PasswordChanged"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Verifica e salva token"
                                        Command="{Binding ConnectMoodleCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Sincronizza corsi"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SyncMoodleCommand}"/>
                            </WrapPanel>
                            <Border Background="{StaticResource SubtleBrush}" CornerRadius="8"
                                    Padding="12" Margin="0,16,0,0">
                                <TextBlock Text="{Binding MoodleStatus}" FontSize="12"
                                           Foreground="{StaticResource InkBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <Border Background="{StaticResource AiSoftBrush}" CornerRadius="8"
                                    Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="PROTEZIONE DELLE CREDENZIALI" FontSize="9"
                                               FontWeight="Bold" Foreground="{StaticResource AiBrush}"/>
                                    <TextBlock Text="Il token Moodle è conservato separatamente tramite Windows DPAPI e non è incluso nei backup locali del database."
                                               FontSize="11" Foreground="{StaticResource InkBrush}"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" MaxWidth="760"
                            HorizontalAlignment="Left" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Backup e ripristino" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Centro di protezione dei dati locali"
                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource WarningSoftBrush}"
                                        CornerRadius="7" Padding="9,6" VerticalAlignment="Center">
                                    <TextBlock Text="INTERFACCIA IN PREPARAZIONE" FontSize="8"
                                               FontWeight="Bold" Foreground="#8A5B1D"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="La schermata completa mostrerà lo storico dei backup, lo stato di integrità e il flusso guidato di ripristino. I comandi non sono ancora collegati qui."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>