<Window x:Class="UniToStudyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniTo StudyHub"
        Height="900"
        Width="1440"
        MinHeight="700"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="Segoe UI Variable"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveIndicator" Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="2" Opacity="0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  Margin="9,0,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarTransitionSurfaceStyle" TargetType="{x:Type Border}"
               BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CalendarViewMode}" Value="Month">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.78" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="7" To="0" Duration="0:0:0.24"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CalendarViewMode}" Value="Week">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.78" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="7" To="0" Duration="0:0:0.24"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding CalendarViewMode}" Value="Day">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.78" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="7" To="0" Duration="0:0:0.24"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs"
                TabStripPlacement="Left"
                SelectedIndex="0"
                Background="{DynamicResource PageBrush}"
                BorderThickness="0">
        <TabControl.Template>
            <ControlTemplate TargetType="{x:Type TabControl}">
                <Grid SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="22,24,18,16">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="11"
                                            Background="{DynamicResource AccentFillBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="S" Foreground="White" FontSize="23"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="StudyHub" Foreground="White"
                                                   FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="UNITO WORKSPACE" Foreground="{DynamicResource SidebarMutedBrush}"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"
                                         Padding="8,5" HorizontalAlignment="Left" Margin="2,24,0,0">
                                    <TextBlock Text="IL TUO PERCORSO UNIVERSITARIO"
                                               Foreground="{DynamicResource AccentBrush}" FontSize="8"
                                               FontWeight="Bold"/>
                                </Border>
                                <Button Click="NavigateToSettings_Click"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Padding="0" Margin="2,16,0,0"
                                        Width="48" Height="48"
                                        HorizontalAlignment="Left"
                                        ToolTip="Apri il mio profilo"
                                        AutomationProperties.Name="Apri il mio profilo">
                                    <Border Width="44" Height="44" CornerRadius="22"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="25" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Margin="12,0,12,8"/>

                            <StackPanel Grid.Row="2" Margin="22,12,20,22">
                                <Border Height="1" Background="{DynamicResource SidebarDividerBrush}" Margin="0,0,0,14"/>
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="11,10">
                                    <StackPanel>
                                        <TextBlock Text="Un passo alla volta." Foreground="{DynamicResource InkBrush}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Il tuo spazio per imparare e crescere."
                                                   Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="30,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="UNITO STUDYHUB" FontSize="9"
                                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Il tuo spazio personale" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="11,7"
                                            VerticalAlignment="Center" MaxWidth="270">
                                        <TextBlock Text="{Binding MoodleStatus}" FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Content="Impostazioni"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Margin="10,0,0,0"
                                            Click="NavigateToSettings_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{DynamicResource PageBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Opacity="1"
                                              RenderTransformOrigin="0.5,0.5"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="01" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Oggi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="La tua dashboard" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,30,34,40">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PANORAMICA" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Buono studio." Style="{StaticResource PageTitleStyle}"
                                       FontSize="30" Margin="0,7,0,5"/>
                            <TextBlock Text="Tutto quello che conta per il tuo percorso universitario, in un colpo d’occhio."
                                       Style="{StaticResource PageSubtitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Apri le materie"
                                VerticalAlignment="Center" Padding="16,11"
                                Click="NavigateToSubjects_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="18" Padding="28" Margin="0,0,12,0"
                                Background="{DynamicResource NavyBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" MaxWidth="560">
                                    <Border Background="#3B2B59" CornerRadius="20" Padding="10,5"
                                            HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <TextBlock Text="IL TUO SPAZIO UNIVERSITARIO" FontSize="9"
                                                   FontWeight="Bold" Foreground="#D9CCFF"/>
                                    </Border>
                                    <TextBlock Text="Un passo alla volta.&#10;Il percorso è tuo."
                                               FontSize="26" FontWeight="SemiBold" Foreground="White"
                                               TextWrapping="Wrap" LineHeight="34"/>
                                    <TextBlock Text="Monitora la carriera, tieni d’occhio il prossimo esame e organizza le prossime sessioni."
                                               FontSize="12" Foreground="#C4BBD8" TextWrapping="Wrap"
                                               Margin="0,12,0,0" MaxWidth="470"/>
                                    <Button Content="Esplora il tuo piano"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,20,0,0"
                                            Click="NavigateToSubjects_Click"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Width="156" Height="156">
                                    <Ellipse Width="148" Height="148" Fill="#5B3B88" Opacity="0.45"/>
                                    <Ellipse Width="112" Height="112" Fill="#8B5CF6" Opacity="0.35"/>
                                    <Ellipse Width="72" Height="72" Fill="#C4B5FD" Opacity="0.72"/>
                                    <Ellipse Width="24" Height="24" Fill="#F5F0FF"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource AnimatedCardStyle}" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PROSSIMO ESAME" Style="{StaticResource KpiLabelStyle}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource WarningSoftBrush}"
                                            CornerRadius="12" Padding="8,4">
                                        <TextBlock Text="PIANIFICATO" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding NextExamNameDisplay}" FontSize="19"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                           TextWrapping="Wrap" Margin="0,18,0,6"/>
                                <TextBlock Text="{Binding NextExamDateDisplay}" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8"
                                        Padding="10,8" Margin="0,18,0,0">
                                    <TextBlock Text="Le date generate sono indicative: verifica sempre la fonte ufficiale."
                                               FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CFU ACQUISITI" Style="{StaticResource KpiLabelStyle}"/>
                                <TextBlock Text="{Binding AcquiredCreditsValue}" FontSize="30"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                           Margin="0,11,0,3"/>
                                <TextBlock Text="Crediti registrati" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="MEDIA PONDERATA" Style="{StaticResource KpiLabelStyle}"/>
                                <TextBlock Text="{Binding AverageDisplay}" FontSize="30"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                           Margin="0,11,0,3"/>
                                <TextBlock Text="Pesata sui CFU" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="MEDIA ARITMETICA" Style="{StaticResource KpiLabelStyle}"/>
                                <TextBlock Text="{Binding ArithmeticAverageDisplay}" FontSize="30"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                           Margin="0,11,0,3"/>
                                <TextBlock Text="Ultimo voto per materia" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnimatedCardStyle}">
                            <StackPanel>
                                <TextBlock Text="VOTO DI PARTENZA" Style="{StaticResource KpiLabelStyle}"/>
                                <TextBlock Text="{Binding ProjectedBaseGradeValue}" FontSize="22"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                           Margin="0,15,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="Proiezione della carriera" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AnimatedCardStyle}"
                                Margin="0,0,12,0" Padding="22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ultimo risultato" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="10" Padding="8,4">
                                        <TextBlock Text="CARRIERA" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding LatestGradeDisplay}" FontSize="13"
                                           Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"
                                           Margin="0,18,0,0"/>
                                <TextBlock Text="I risultati registrati aggiornano qui il riepilogo della tua carriera."
                                           FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource AnimatedCardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Le tue materie" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ActiveCoursesCount}" FontSize="28"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="In corso" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ArchivedCoursesCount}" FontSize="28"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="In archivio" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Gestisci materie" Style="{StaticResource QuietButtonStyle}"
                                        HorizontalAlignment="Left" Margin="-10,13,0,0"
                                        Click="NavigateToSubjects_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="3,16,3,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="02" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Materie" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Corsi e archivio" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,30,32,36">
                    <TextBlock Text="CARRIERA UNIVERSITARIA" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Le tue materie" Style="{StaticResource PageTitleStyle}"
                               Margin="0,7,0,4"/>
                    <TextBlock Text="Tieni insieme insegnamenti da preparare, esami conclusi e risultati registrati."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22"/>

                    <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Aggiungi un insegnamento"
                                       Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <StackPanel Width="300" Margin="0,0,10,0">
                                    <TextBlock Text="Nome materia" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding CourseNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Nome dell'insegnamento"/>
                                </StackPanel>
                                <StackPanel Width="105" Margin="0,0,10,0">
                                    <TextBlock Text="CFU" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding CourseCfuInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Crediti formativi"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text=" " FontSize="10" Margin="0,0,0,5"/>
                                    <Button Content="Aggiungi materia" Command="{Binding AddCourseCommand}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AnimatedCardStyle}" Margin="0,0,0,14">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Registra un tentativo d’esame" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Registra un esame superato (accettato o rifiutato), non superato oppure un’idoneità. Il voto numerico serve solo per gli esiti superati."
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <StackPanel Width="300" Margin="0,0,10,0">
                                        <TextBlock Text="Materia" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding Courses}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding SelectedGradeCourse}"/>
                                    </StackPanel>
                                    <StackPanel Width="185" Margin="0,0,10,0">
                                        <TextBlock Text="Esito del tentativo" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <ComboBox ItemsSource="{Binding AttemptModeOptions}" SelectedItem="{Binding AttemptModeInput}"/>
                                    </StackPanel>
                                    <StackPanel Width="90" Margin="0,0,10,0">
                                        <TextBlock Text="Voto (18–30)" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding GradeValueInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text=" " FontSize="10" Margin="0,0,0,5"/>
                                        <Button Content="Registra tentativo" Command="{Binding AddGradeCommand}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Archivio insegnamenti" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Le materie con un voto registrato sono raccolte nell'archivio."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AllCoursesCount, StringFormat={}{0} materie totali}"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CourseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Cerca per nome o codice" MinWidth="190"
                                 AutomationProperties.Name="Cerca materie per nome o codice"/>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Content="{Binding ActiveCoursesCount, StringFormat='In corso ({0})'}"
                                         GroupName="CourseFilters" Tag="active"
                                         IsChecked="True" Checked="CourseFilter_Checked"
