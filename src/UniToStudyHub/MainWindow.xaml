<ui:FluentWindow x:Class="UniToStudyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:UniToStudyHub.Views"
        Title="UniTo StudyHub"
        Height="900"
        Width="1440"
        MinHeight="700"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="Segoe UI Variable"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootLayout">
        <ui:NavigationView x:Name="RootNavigationView"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           OpenPaneLength="244"
                           IsBackButtonVisible="Collapsed"
                           PaneTitle="StudyHub">
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="18,18,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource AccentFillBrush}">
                            <TextBlock Text="S" Foreground="White" FontSize="22"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="StudyHub" Foreground="{DynamicResource InkBrush}"
                                       FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="UNITO WORKSPACE" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="IL TUO PERCORSO UNIVERSITARIO"
                               Foreground="{DynamicResource MutedBrush}" FontSize="9"
                               FontWeight="SemiBold" Margin="2,20,0,0"/>
                </StackPanel>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.Today" Content="Oggi" Tag="0" Click="NavigationItem_Click"/>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.Courses" Content="Materie" Tag="1" Click="NavigationItem_Click"/>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.Calendar" Content="Calendario" Tag="2" Click="NavigationItem_Click"/>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.StudyLab" Content="Studio Lab" Tag="3" Click="NavigationItem_Click"/>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.Academy" Content="Accademia" Tag="4" Click="NavigationItem_Click"/>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.Progress" Content="Progressi" Tag="5" Click="NavigationItem_Click"/>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem AutomationProperties.AutomationId="Navigation.Settings" Content="Impostazioni" Tag="6" Click="NavigationItem_Click"/>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.Header>
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="26,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="UNITO STUDYHUB" FontSize="9"
                                       FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="Il tuo spazio personale" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource SubtleBrush}"
                                    CornerRadius="7" Padding="10,7"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding MoodleStatus}" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Button Content="Impostazioni"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="NavigateToSettings_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <TabControl x:Name="MainTabs"
                    AutomationProperties.AutomationId="MainTabs"
                    SelectedIndex="0"
                    Background="{DynamicResource PageBrush}"
                    BorderThickness="0"
                    Visibility="Collapsed">
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ControlTemplate>
            </TabControl.Template>

        <TabItem AutomationProperties.AutomationId="PageTab.Dashboard">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="01" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Oggi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="La tua dashboard" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:DashboardView x:Name="DashboardPage"/>
        </TabItem>

        <TabItem AutomationProperties.AutomationId="PageTab.Courses">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="02" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Materie" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Corsi e archivio" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:CoursesView x:Name="CoursesPage"/>
        </TabItem>

        <TabItem AutomationProperties.AutomationId="PageTab.Calendar">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="03" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Calendario" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Appelli e pianificazione" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:CalendarView x:Name="CalendarPage"/>
        </TabItem>

        <TabItem AutomationProperties.AutomationId="PageTab.StudyLab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="04" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Studio Lab" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Focus e allenamento" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:StudyLabView x:Name="StudyLabPage"/>
        </TabItem>

        <TabItem AutomationProperties.AutomationId="PageTab.Academy">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="05" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Accademia" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Apprendimento intelligente" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:AcademyView x:Name="AcademyPage"/>
        </TabItem>

        <TabItem AutomationProperties.AutomationId="PageTab.Progress">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="06" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Progressi" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Statistiche di carriera" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:ProgressView x:Name="ProgressPage"/>
        </TabItem>

        <TabItem AutomationProperties.AutomationId="PageTab.Settings">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource NavyBrush}">
                        <TextBlock Text="07" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Impostazioni" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Profilo e integrazioni" FontSize="10" Opacity="0.76"/>
                    </StackPanel>
                </StackPanel>
            </TabItem.Header>
            <views:SettingsView x:Name="SettingsPage"/>
        </TabItem>
    </TabControl>
</Grid>
</ui:FluentWindow>